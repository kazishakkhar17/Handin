# ---------------------------------------------------------------------------
# Backend (ASP.NET Core) — these map to appsettings.json using the standard
# ASP.NET Core double-underscore convention for nested keys, e.g.
# ConnectionStrings__DefaultConnection overrides ConnectionStrings:DefaultConnection.
# Set these as real environment variables, or via `dotnet user-secrets` locally,
# or via docker-compose (see docker-compose.yml). Never commit real values.
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=postgres

# Generate a real secret locally, e.g.: openssl rand -base64 48
Jwt__Secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
Jwt__Issuer=AssignmentSystem
Jwt__Audience=AssignmentSystemClient
Jwt__ExpiryMinutes=120

Cors__AllowedOrigins__0=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend (Next.js) — copy this into frontend/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
